# Copie para .env.local (no computador) ou cadastre na Vercel (Settings → Environment Variables).
# Os dois valores ficam no Supabase: Project Settings → API (ou "Connect").
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Conexão bancária (Pluggy / Open Finance). Opcional. NUNCA use o prefixo NEXT_PUBLIC_ nestas chaves.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# e-mails de login que podem usar a conexão bancária, separados por vírgula
PLUGGY_ALLOWED_EMAILS=
